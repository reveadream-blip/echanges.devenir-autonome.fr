# Copier en .env.local (développement) ; sur Cloudflare Pages/Workers, définir les variables côté build si besoin.
# URL publique du site (canonical, Open Graph) — sans slash final
VITE_PUBLIC_SITE_URL=https://echanges.devenirautonome.fr
# Google Search Console : Propriété > Vérification > Balise HTML — coller le "content" ici
# Puis : Indexation > Sitemaps > ajouter https://echanges.devenirautonome.fr/sitemap.xml
VITE_GOOGLE_SITE_VERIFICATION=
